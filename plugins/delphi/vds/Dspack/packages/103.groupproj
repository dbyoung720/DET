    <Target Name="DSPackDesign_D7:Make">
        <MSBuild Projects="DSPackDesign_D7.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="DSPack_D7;DSPackDesign_D7"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="DSPack_D7:Clean;DSPackDesign_D7:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="DSPack_D7:Make;DSPackDesign_D7:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
